# 設定清單（可 commit）。格式：每個變數上一行寫 `# 說明`，下一行 `KEY=值`；
# 要甲方決定的值寫 CHANGE_ME；值不加引號、不含空白或 #（Makefile 以 -include 讀 .env）。實際值只放主目錄 .env（不 commit）。
# 新增變數由 architect 負責；Makefile 會自動 export 本檔列出的每個變數。

# 後端 API 監聽的 port（make api-run；前端 dev server 會把 /api 轉給它）
API_PORT=CHANGE_ME
# 前端 dev server 的 port（make web-dev）
WEB_PORT=CHANGE_ME
# 本機 PostgreSQL 對外的 port（make infra-up，只綁 127.0.0.1）
POSTGRES_PORT=CHANGE_ME
# 本機 PostgreSQL 的資料庫名稱
POSTGRES_DB=cdp
# 本機 PostgreSQL 的帳號（容器初始化時建立）
POSTGRES_USER=cdp
# 本機 PostgreSQL 的密碼（機密）
POSTGRES_PASSWORD=CHANGE_ME
# 本機 RabbitMQ AMQP 對外的 port（make infra-up，只綁 127.0.0.1）
RABBITMQ_PORT=CHANGE_ME
# 本機 RabbitMQ 管理介面的 port（瀏覽器開 http://127.0.0.1:<port>）
RABBITMQ_MANAGEMENT_PORT=CHANGE_ME
# 本機 RabbitMQ 的帳號（容器初始化時建立）
RABBITMQ_USER=cdp
# 本機 RabbitMQ 的密碼（機密）
RABBITMQ_PASSWORD=CHANGE_ME
# 後端連 PostgreSQL 的主機（application.yml 的 datasource.url）
POSTGRES_HOST=127.0.0.1
# 後端連 RabbitMQ 的主機
RABBITMQ_HOST=127.0.0.1
# 已廢除（D-063）：REFACTOR-01 合併時與程式一起刪除；合併前程式仍讀（ULID，26 字元）
CDP_TENANT_ID=CHANGE_ME
# 推進迴圈與事件派發的輪詢間隔（ISO-8601 Duration）
ENGINE_POLL_INTERVAL=PT1S
# 推進迴圈與事件派發每批筆數
ENGINE_BATCH_SIZE=100
# 事件派發重試：總共嘗試次數、初始退避、退避上限（ISO-8601 Duration；spec 07 §11）
ENGINE_DISPATCH_MAX_ATTEMPTS=5
ENGINE_DISPATCH_BACKOFF_INITIAL=PT10S
ENGINE_DISPATCH_BACKOFF_MAX=PT10M
# outbox relay 的輪詢間隔（ISO-8601 Duration）
OUTBOX_RELAY_POLL_INTERVAL=PT1S
# outbox relay 每批筆數
OUTBOX_RELAY_BATCH_SIZE=100
# relay publish 失敗後該列延後多久再推（ISO-8601 Duration）
OUTBOX_RELAY_RETRY_DELAY=PT30S
# consumer 暫時性 DB 例外重排前等待（ISO-8601 Duration）
DELIVERY_REQUEUE_DELAY=PT5S
# 事件攝取 API 的 Bearer 金鑰（機密，隨機產生）
CDP_INGEST_API_KEY=CHANGE_ME
# 旅程建立／查詢 API 的 Bearer 金鑰（機密，隨機產生）
CDP_ADMIN_API_KEY=CHANGE_ME
# 客服登入帳號
CDP_SUPPORT_USERNAME=support
# 客服登入密碼（機密，隨機產生）
CDP_SUPPORT_PASSWORD=CHANGE_ME
# 客服 session 閒置逾時（ISO-8601 Duration）
CDP_SESSION_IDLE_TIMEOUT=PT30M
# 軌跡頁可明文顯示的屬性鍵（逗號分隔，例 cart_id,cart_total；填 - = 全部遮罩，規則見契約 §4.4）
CDP_TRACE_PLAIN_KEYS=-
# --- v0.2.0（docs/design/DESIGN-03.md「設定」；各變數由實作單接上，接上前程式不讀） ---
# 手機號碼以 0 開頭時補上的國碼（只填數字，不含 +；profiles.md §1.1）
CDP_PHONE_DEFAULT_COUNTRY_CODE=CHANGE_ME
# relay 等 broker publisher confirm 的上限（ISO-8601 Duration）
OUTBOX_RELAY_CONFIRM_TIMEOUT=PT5S
# relay 搶到一列後的 lease 長度，須大於 OUTBOX_RELAY_CONFIRM_TIMEOUT（ISO-8601 Duration）
OUTBOX_RELAY_LEASE=PT30S
# 連 RabbitMQ 的逾時（ISO-8601 Duration）
RABBITMQ_CONNECTION_TIMEOUT=PT10S
# 關機時等 consumer 處理中訊息的上限（ISO-8601 Duration）
DELIVERY_SHUTDOWN_TIMEOUT=PT30S
# 背景迴圈的排程執行緒數，須不小於迴圈數（推進、派發、relay；第二版加旅程停止清理）
CDP_SCHEDULER_POOL_SIZE=4
# 每個迴圈「滿批續做」單次最長持續時間（ISO-8601 Duration）
CDP_LOOP_MAX_DRAIN=PT10S
# 登入限速：同一 email 連續密碼錯誤達此次數即鎖定（auth.md §3）
CDP_LOGIN_MAX_FAILURES=5
# 登入限速：失敗計數的有效期間與鎖定長度（ISO-8601 Duration；auth.md §3）
CDP_LOGIN_LOCKOUT=PT15M
# 管理金鑰可否直接建立旅程（true=允許並留紀錄，false=回 403、一律送審；journeys.md §3.3，第二版起生效）
CDP_ADMIN_KEY_JOURNEY_CREATE=true
